# Your school's Canvas address (no trailing slash)
CANVAS_BASE_URL=https://yourschool.instructure.com
# Canvas > Account > Settings > Approved Integrations > + New Access Token
CANVAS_TOKEN=paste-your-canvas-token-here
# Claude API key from https://platform.claude.com (Settings > API keys)
ANTHROPIC_API_KEY=paste-your-claude-api-key-here
# Optional
PORT=3001
